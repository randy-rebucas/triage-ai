# ─────────────────────────────────────────────────────────────────
# CMS Triage AI — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_NAME=ClinicAI
NEXT_PUBLIC_APP_URL=https://www.myclinicsoft.solutions
NODE_ENV=production

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/cms-triage-ai?retryWrites=true&w=majority

# ── Multi-tenancy ─────────────────────────────────────────────────
# Path-based routing: https://www.myclinicsoft.solutions/{tenant}/login
# ROOT_DOMAIN is used for CSRF origin validation.
ROOT_DOMAIN=myclinicsoft.solutions
NEXT_PUBLIC_ROOT_DOMAIN=myclinicsoft.solutions

# ── External Tenant Registry ───────────────────────────────────────
# Tenant lookups (directory, validate, public) call this API.
# For local dev, change to http://localhost:3000 to use the local DB fallback.
MYCLINICSOFT_API_URL=https://www.myclinicsoft.solutions

# Cookie domain — not required for path-based tenancy.
# Leave empty unless you add subdomain-based features later.
COOKIE_DOMAIN=

# ── Authentication ────────────────────────────────────────────────
# Primary JWT secret (used by API routes via jsonwebtoken)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# Alias used by Edge middleware (jose). Can be same value as JWT_SECRET.
SESSION_SECRET=your-super-secret-jwt-key-min-32-chars

REFRESH_TOKEN_SECRET=your-refresh-token-secret-here

# ── Security ──────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
COOKIE_SECURE=true      # HTTPS is required in production
ENCRYPTION_KEY=         # 32-byte base64 key: openssl rand -base64 32

# Cron routes — all /api/cron/* require:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=            # openssl rand -hex 32

# Install routes — all /api/install/* require this in production
INSTALL_SECRET=         # openssl rand -hex 32

# ── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.3

# ── PayPal (Subscription Billing) ────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=      # From PayPal Developer Dashboard

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_AUTH=10
RATE_LIMIT_TRIAGE=30
RATE_LIMIT_API=100

# ── Audit ─────────────────────────────────────────────────────────
ENABLE_AUDIT_LOGS=true

# ── Optional: SMS (Twilio) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Optional: Email (SMTP) ────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Optional: File Storage (Cloudinary) ──────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Optional: Web Push Notifications ─────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────
# Local development — minimum .env.local overrides
# ─────────────────────────────────────────────────────────────────
#   NEXT_PUBLIC_APP_URL=http://localhost:3000
#   NODE_ENV=development
#   ROOT_DOMAIN=localhost
#   NEXT_PUBLIC_ROOT_DOMAIN=localhost
#   COOKIE_DOMAIN=          (leave empty)
#   COOKIE_SECURE=false
#   MONGODB_URI=mongodb://localhost:27017/clinic-management
#   JWT_SECRET=any-long-random-string-min-32-chars
#   SESSION_SECRET=any-long-random-string-min-32-chars
#
# Path-based tenant URLs (no hosts file changes needed):
#   http://localhost:3000/demo-clinic/login
#   http://localhost:3000/demo-clinic/patient/profile
